{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "senior-care-compass",
  "main": "worker.js",
  "compatibility_date": "2026-09-27",
  "previews": {
    "observability": {
      "logs": {
        "enabled": true,
        "head_sampling_rate": 1,
        "invocation_logs": false,
        "persist": true
      },
      "traces": {
        "enabled": false
      },
      "issue_detection": {
        "enabled": false
      }
    }
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash"
  }
}
